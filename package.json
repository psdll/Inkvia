{
  "name": "inkvia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "desktop:prepare": "node desktop/scripts/prepare.mjs",
    "predesktop:start": "node desktop/scripts/prepare-media.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "predev": "node scripts/dev-migrate.cjs",
    "dev:preflight": "node scripts/dev-preflight.cjs",
    "dev": "node scripts/next-runner.cjs dev --web-only --distDir .next-dev-web -p 3100",
    "dev:web": "node scripts/next-runner.cjs dev --web-only --distDir .next-dev-web -p 3100",
    "dev:full": "node scripts/next-runner.cjs dev --with-workers --distDir .next-dev-webpack -p 3100",
    "dev:webpack": "node scripts/next-runner.cjs dev --with-workers --distDir .next-dev-webpack -p 3100",
    "prebuild": "node scripts/generate-prisma-local.cjs",
    "build": "node scripts/runtime-command.cjs build next build",
    "start": "node scripts/runtime-command.cjs production next start -p 3000",
    "start:standalone": "node scripts/runtime-command.cjs production .next/standalone/server.js",
    "worker:canvas": "tsx --conditions=react-server scripts/canvas-worker.ts",
    "worker:canvas:generation": "tsx --conditions=react-server scripts/canvas-worker.ts --role=generation",
    "worker:canvas:media": "tsx --conditions=react-server scripts/canvas-worker.ts --role=media",
    "worker:image-batch": "tsx --conditions=react-server scripts/image-batch-worker.ts",
    "worker:live-video:prompt": "tsx --conditions=react-server scripts/live-video-batch-worker.ts --role=prompt",
    "worker:live-video:video": "tsx --conditions=react-server scripts/live-video-batch-worker.ts --role=video",
    "canvas:projection:rebuild": "node scripts/canvas-projection-rebuild.mjs",
    "canvas:submission:reconcile": "tsx --conditions=react-server scripts/canvas-reconcile-submission.ts",
    "preview": "npm run build && node scripts/runtime-command.cjs local next start -p 3001",
    "deploy:check": "node scripts/deploy-preflight.mjs",
    "release:validate-migrations": "node scripts/validate-migration-policy.mjs",
    "load:admin-gate": "node scripts/admin-read-model-load-gate.mjs",
    "load:canvas": "node scripts/canvas-burst-load.mjs",
    "migrate:split-libraries": "node scripts/migrate-split-product-material-folders.mjs",
    "repair:media-paths": "node scripts/repair-media-paths.mjs",
    "backfill:media-previews": "node scripts/backfill-media-previews.mjs",
    "backfill:material-thumbnails": "node scripts/runtime-command.cjs local node_modules/tsx/dist/cli.mjs scripts/backfill-material-thumbnails.ts",
    "backfill:sizes": "node scripts/backfill-generation-sizes.mjs",
    "lint": "next lint",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:user-migration": "node scripts/validate-user-migration.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/dev-migrate.cjs migrate dev",
    "prisma:deploy": "node scripts/dev-migrate.cjs migrate deploy",
    "prisma:status": "node scripts/dev-migrate.cjs migrate status",
    "prisma:dbpush": "node scripts/dev-migrate.cjs db push",
    "test:p0": "node scripts/validate-p0.cjs",
    "passwords:inspect": "tsx --conditions=react-server scripts/password-credentials-backfill.ts --inspect",
    "dev:p0": "node scripts/dev-p0.cjs",
    "dev:p1": "node scripts/dev-p1.cjs",
    "test:p1": "node scripts/validate-p1.cjs",
    "test:p2": "node scripts/validate-p2.cjs",
    "desktop:pack": "node desktop/scripts/pack.mjs",
    "desktop:dist:mac": "node desktop/scripts/pack.mjs darwin",
    "desktop:dist:win": "node desktop/scripts/pack.mjs win32",
    "i18n:check": "node scripts/check-i18n.mjs",
    "desktop:dist:win:cross": "node desktop/scripts/pack-win-cross.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@earendil-works/pi-agent-core": "0.74.2",
    "@earendil-works/pi-ai": "0.74.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.19.3",
    "@soundtouchjs/core": "2.1.1",
    "@tanstack/react-query": "^5.100.14",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-placeholder": "^3.27.3",
    "@tiptap/markdown": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@tiptap/suggestion": "^3.27.3",
    "@types/ali-oss": "^6.23.3",
    "@types/rbush": "^4.0.0",
    "@xyflow/react": "^12.11.0",
    "@xyflow/system": "~0.0.77",
    "@zip.js/zip.js": "^2.15.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "codemirror": "^6.0.2",
    "embedded-postgres": "16.16.0-beta.19",
    "fabric": "^5.3.0",
    "fs-extra": "^11.2.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.474.0",
    "mediabunny": "1.61.3",
    "next": "14.2.35",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "rbush": "^4.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.23.1",
    "undici": "^6.27.0",
    "uuid": "^9.0.1",
    "yauzl": "^3.3.1",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/fabric": "^5.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^9.0.8",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
