generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Canvas Creative Agent owns its state; existing AgentRun planner data is not reused.
model CreativeAgentSession {
  id          String   @id
  actorUserId Int      @map("actor_user_id")
  canvasId    Int      @map("canvas_id")
  transcript  Json     @default("[]")
  creationContext Json? @map("creation_context")
  title       String   @default("新对话")
  titleSource String   @default("auto") @map("title_source")
  titleMessageId String? @map("title_message_id")
  titleAttemptMessageId String? @map("title_attempt_message_id")
  titleClaimId String? @map("title_claim_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  runs        CreativeAgentRun[]
  messages    CreativeAgentMessage[]
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  canvas      Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([actorUserId, canvasId, updatedAt])
}

model CreativeAgentRun {
  id             String   @id
  sessionId      String   @map("session_id")
  actorUserId    Int      @map("actor_user_id")
  canvasId       Int      @map("canvas_id")
  status         String
  epoch          Int      @default(0)
  workerId       String?  @map("worker_id")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  input          Json
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  session        CreativeAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages       CreativeAgentMessage[]
  events         CreativeAgentEvent[]
  traceEvents    CreativeAgentTraceEvent[]
  actions        CreativeAgentAction[]
  decisions      CreativeAgentDecision[]
  requests       CreativeAgentRequest[]

  @@index([status, createdAt])
  @@index([sessionId, createdAt])
  @@index([canvasId, status])
}

model CreativeAgentMessage {
  id            String   @id
  sessionId     String   @map("session_id")
  runId         String   @map("run_id")
  role          String
  text          String   @db.Text
  referenceData Json?    @map("reference_data")
  inputHash     String?  @map("input_hash")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  session       CreativeAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run           CreativeAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model CreativeAgentEvent {
  sequence  BigInt   @id @default(autoincrement())
  runId     String   @map("run_id")
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run       CreativeAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sequence])
}

model CreativeAgentTraceEvent {
  id           String @id
  sequence     BigInt @unique @default(autoincrement())
  runId        String @map("run_id")
  spanId       String @map("span_id")
  parentSpanId String? @map("parent_span_id")
  category     String
  type         String
  title        String
  status       String
  summary      Json @default("{}")
  detail       Json?
  eventKey     String? @map("event_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run          CreativeAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, eventKey])
  @@index([runId, sequence])
  @@index([runId, spanId, sequence])
  @@index([createdAt])
}

model CreativeAgentAction {
  id          String   @id
  runId       String   @map("run_id")
  actorUserId Int      @map("actor_user_id")
  canvasId    Int      @map("canvas_id")
  epoch       Int
  kind        String
  inputHash   String   @map("input_hash")
  state       String
  result      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  run         CreativeAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model CreativeAgentDecision {
  id           String   @id
  runId        String   @map("run_id")
  actionId     String   @unique @map("action_id")
  proposalHash String   @map("proposal_hash")
  title        String
  question     String
  options      Json
  fields       Json     @default("[]")
  binding      Json?
  state        String
  answer       Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  run          CreativeAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model CreativeAgentRequest {
  id          String   @id
  actorUserId Int      @map("actor_user_id")
  inputHash   String   @map("input_hash")
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  runId       String?  @map("run_id")
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  run         CreativeAgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model WhitelistName {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                 Int                 @id @default(autoincrement())
  username           String              @unique
  password           String
  passwordCipher     Json?
  credentialVersion  Int                 @default(0)
  passwordResetGrants PasswordResetGrant[]
  token              String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  generations        Generation[]
  mediaLibraryItems  MediaLibraryItem[]  @relation("MediaLibraryOwner")
  createdMaterialAssets MaterialAsset[]  @relation("MaterialAssetCreatedBy")
  selectedMaterialAssets MaterialAsset[] @relation("MaterialAssetSelectedBy")
  materialAssetDownloads MaterialAssetDownload[]
  materialAssetSelectionEvents MaterialAssetSelectionEvent[]
  agentConversations AgentConversation[]
  creativeAgentSessions CreativeAgentSession[]
  creativeAgentRequests CreativeAgentRequest[]
  userMemories       UserMemory[]
  agentMemoryProfile AgentMemoryProfile?
  canvases           Canvas[]
  canvasVoiceFavorites CanvasVoiceFavorite[]
  canvasMemberships  CanvasMember[]
  canvasMutations    CanvasMutation[]
  canvasProjects     CanvasProject[]
  canvasRuns         CanvasRun[]
  canvasRunSteps     CanvasRunStep[]
  mediaAssets        MediaAsset[]
  imageBatches       ImageBatch[]
  imageBatchGroups   ImageBatchGroup[]
  liveVideoBatches   LiveVideoBatch[]
  toolWorkspaceDrafts ToolWorkspaceDraft[]
  promptPresets               PromptPreset[]
  builtinPromptDeletions      UserBuiltinPromptDeletion[]
  promptPresetMigrationStates PromptPresetMigrationState[]
  virtualAvatars     VirtualAvatar[]
  promptReverseTasks PromptReverseTask[]
  rolePositioningDrafts RolePositioningDraft[]
  roleSkills          UserRoleSkill[]
}

model PasswordResetGrant {
  id                String    @id @default(uuid()) @db.Uuid
  userId            Int
  tokenDigest       String    @unique @db.Char(64)
  credentialVersion Int
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  createdBy         String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CanvasVoiceFavorite {
  userId        Int
  providerScope String   @db.VarChar(128)
  voiceId       String   @db.VarChar(256)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, providerScope, voiceId])
  @@index([userId, createdAt])
}

model SystemRoleSkill {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(64)
  summary       String    @db.VarChar(200)
  category      String    @db.VarChar(64)
  coverUrl      String?   @db.Text
  content       String    @db.Text
  usageScenario String    @db.Text
  usageGuide    String    @db.Text
  mediaType     String?   @db.VarChar(16)
  status        String    @default("hidden") @db.VarChar(16)
  revision      Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, deletedAt, updatedAt])
  @@index([category, status, deletedAt])
}

model UserRoleSkill {
  id            BigInt    @id @default(autoincrement())
  authUserId    Int
  authUser      User      @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  name          String    @db.VarChar(64)
  summary       String    @db.VarChar(200)
  category      String    @db.VarChar(64)
  coverUrl      String?   @db.Text
  content       String    @db.Text
  usageScenario String    @db.Text
  usageGuide    String    @db.Text
  mediaType     String?   @db.VarChar(16)
  revision      Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authUserId, deletedAt, updatedAt])
  @@index([authUserId, category, deletedAt])
}

model PromptPreset {
  id         BigInt   @id @default(autoincrement())
  authUserId Int
  authUser   User     @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(128)
  category   String   @db.VarChar(64)
  content    String   @db.Text
  revision   Int      @default(1)
  legacyKey  String?  @db.VarChar(256)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([authUserId, legacyKey])
  @@index([authUserId, deletedAt, updatedAt])
}

model BuiltinPromptPreset {
  id         BigInt   @id @default(autoincrement())
  key        String   @unique @db.VarChar(256)
  name       String   @db.VarChar(128)
  category   String   @db.VarChar(64)
  content    String   @db.Text
  revision   Int      @default(1)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletions  UserBuiltinPromptDeletion[]

  @@index([deletedAt, updatedAt])
}

model UserBuiltinPromptDeletion {
  authUserId           Int
  builtinPromptPresetId BigInt
  authUser             User                @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  builtinPromptPreset  BuiltinPromptPreset @relation(fields: [builtinPromptPresetId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())

  @@id([authUserId, builtinPromptPresetId])
  @@index([builtinPromptPresetId])
}

model PromptPresetMigrationState {
  id          BigInt   @id @default(autoincrement())
  subjectKey  String   @unique @db.VarChar(128)
  authUserId  Int?
  authUser    User?    @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  source      String   @db.VarChar(64)
  version     Int
  digest      String   @db.VarChar(64)
  rowCount    Int
  completedAt DateTime @default(now())

  @@index([authUserId, source])
}

// 无限画布：每个用户的节点画布文档（React Flow 的 nodes+edges 存成 JSON）。
// 按 authUserId 隔离 —— 比原版单用户更强。软删除进回收站(deletedAt)。
model Canvas {
  creativeAgentSessions CreativeAgentSession[]
  id         Int            @id @default(autoincrement())
  publicId   String         @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @db.VarChar(32)
  authUserId Int
  authUser   User           @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  projectId  Int?
  project    CanvasProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title      String         @default("未命名项目")
  data       Json           @default("{}")
  thumbnail  String?
  sortOrder  Int            @default(0)
  revision   Int            @default(1)
  revision64 BigInt         @default(1)
  projectionRevision BigInt @default(0)
  snapshotRevision BigInt   @default(0)
  currentSnapshotId BigInt? @unique
  nodeCount  Int            @default(0)
  edgeCount  Int            @default(0)
  settings   Json           @default("{}")
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  runs       CanvasRun[]
  mutations  CanvasMutation[]
  snapshots  CanvasSnapshot[] @relation("CanvasSnapshots")
  currentSnapshot CanvasSnapshot? @relation("CanvasCurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: SetNull)
  nodeStates CanvasNodeState[]
  edgeStates CanvasEdgeState[]
  members    CanvasMember[]

  @@index([authUserId, updatedAt])
  @@index([authUserId, deletedAt, updatedAt])
  @@index([authUserId, projectId, sortOrder])
  @@index([projectId, deletedAt, sortOrder])
  @@index([deletedAt, id])
}

model CanvasProject {
  id         Int       @id @default(autoincrement())
  authUserId Int
  authUser   User      @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  name       String    @default("未命名项目")
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  canvases   Canvas[]

  @@index([authUserId, deletedAt, sortOrder])
  @@index([authUserId, updatedAt])
}

model CanvasRun {
  id            Int       @id @default(autoincrement())
  authUserId    Int
  authUser      User      @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  canvasId      Int
  canvas        Canvas    @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  status        String    @default("queued")
  graphRevision Int
  graphRevision64 BigInt  @default(1)
  requestKey    String?   @unique @db.Uuid
  requestHash   String?   @db.Char(64)
  priority      Int       @default(0)
  state         Json      @default("{}")
  queuedAt      DateTime  @default(now())
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  finishedAt    DateTime?
  steps         CanvasRunStep[]

  @@index([authUserId, updatedAt])
  @@index([canvasId, status, updatedAt])
  @@index([status, priority, queuedAt])
}

model CanvasRunStep {
  id                BigInt            @id @default(autoincrement())
  runId             Int
  run               CanvasRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  authUserId        Int
  authUser          User              @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  stepKey           String            @db.VarChar(256)
  nodeId            String            @db.VarChar(256)
  nodeKind          String            @db.VarChar(64)
  status            String            @default("queued")
  priority          Int               @default(0)
  requestKey        String            @unique @db.Uuid
  dependencies      Json              @default("[]")
  input             Json
  provider          String?           @db.VarChar(128)
  providerRequestId String?           @db.VarChar(512)
  attempts          Int               @default(0)
  nextRetryAt       DateTime          @default(now())
  leaseOwner        String?           @db.VarChar(256)
  leaseUntil        DateTime?
  submittedAt       DateTime?
  appliedAt         DateTime?
  errorCode         String?           @db.VarChar(128)
  errorMessage      String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  outputs           CanvasRunOutput[]

  @@unique([runId, stepKey])
  @@index([status, nextRetryAt, priority, createdAt])
  @@index([authUserId, status, createdAt])
  @@index([status, leaseUntil])
  @@index([provider, providerRequestId])
}

model CanvasRunOutput {
  id          BigInt        @id @default(autoincrement())
  runStepId   BigInt
  runStep     CanvasRunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  outputSlot  String        @db.VarChar(128)
  mediaId     String?       @db.Uuid
  media       MediaAsset?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  generationId Int?
  payload     Json
  payloadHash String        @db.Char(64)
  createdAt   DateTime      @default(now())

  @@unique([runStepId, outputSlot])
  @@index([mediaId])
  @@index([generationId])
}

model Generation {
  id               Int          @id @default(autoincrement())
  canvasId         Int?
  userId           String       @default("legacy")
  authUserId       Int?
  authUser         User?        @relation(fields: [authUserId], references: [id])
  type             String // 'face_swap', 'image_edit', 'video_gen'
  source           String       @default("tool") // 'tool', 'agent'
  prompt           String
  model            String? // e.g., 'Sora-2', 'Qwen-VL'
  status           String // 'pending', 'success', 'failed'
  externalProvider String?
  externalTaskId   String?
  requestKey       String?       @unique @db.Uuid
  errorMsg         String?
  localPath        String? // e.g., '/uploads/2023-10-27/uuid.png'
  templateData     String? // JSON snapshot used by "一键同款"回填
  createdAt        DateTime     @default(now())
  restoredAt       DateTime?
  updatedAt        DateTime     @default(now()) @updatedAt
  finishedAt       DateTime?
  usageLedger      UsageLedger?
  sizeBytes        Int? // cached size of localPath in bytes (avoids per-request fs.stat in admin views)
  inputMedia       GenerationInputMedia[]
  batchOutput      ImageBatchOutput?
  liveVideoBatchOutput LiveVideoBatchOutput?

  @@index([userId])
  @@index([authUserId])
  // Hot paths for admin analytics & user detail: filter by user + order by time, or filter by status/type
  @@index([authUserId, createdAt])
  @@index([userId, createdAt])
  @@index([authUserId, status])
  @@index([authUserId, type])
  @@index([authUserId, updatedAt, id])
  @@index([userId, updatedAt, id])
  @@index([authUserId, type, finishedAt, createdAt, id])
  @@index([userId, type, finishedAt, createdAt, id])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([localPath])
  @@index([authUserId, source, status, createdAt, id], map: "Generation_canvas_history_all_idx")
  @@index([authUserId, canvasId, status, createdAt, id], map: "Generation_canvas_history_current_idx")
}

model AdminAssetFeed {
  id             Int        @id @default(autoincrement())
  generationId   Int        @unique
  userId         String
  authUserId     Int?
  type           String
  status         String
  mediaKind      String
  thumbUrl       String?
  displayUrl     String?
  previewUrl     String?
  posterUrl      String?
  localPath      String?
  outputPaths    Json
  inputMaterials Json
  errorMsg       String?
  externalTaskId String?
  createdAt      DateTime
  updatedAt      DateTime
  finishedAt     DateTime?
  deletedAt      DateTime?
  syncedAt       DateTime   @default(now()) @updatedAt

  @@index([generationId])
  @@index([authUserId, type, createdAt, id])
  @@index([userId, type, createdAt, id])
  @@index([authUserId, updatedAt, id])
  @@index([userId, updatedAt, id])
  @@index([createdAt, id])
}

model AdminEvent {
  id          Int       @id @default(autoincrement())
  eventType   String
  entityType  String
  entityId    String
  userId      String?
  authUserId  Int?
  payload     Json      @default("{}")
  occurredAt  DateTime  @default(now())
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType, occurredAt])
  @@index([authUserId, occurredAt])
  @@index([processedAt, id])
  @@index([entityType, entityId])
  @@index([status, availableAt, id])
  @@index([status, lockedAt])
}

model AdminUserSummary {
  adminKey        String   @id
  userId          String
  authUserId      Int?
  username        String?
  lastActiveAt    DateTime?
  todayTaskCount  Int      @default(0)
  last7TaskCount  Int      @default(0)
  last30TaskCount Int      @default(0)
  totalTaskCount  Int      @default(0)
  successTaskCount Int     @default(0)
  failedTaskCount Int      @default(0)
  successRate30d  Float    @default(0)
  failedCount30d  Int      @default(0)
  storageBytes    BigInt   @default(0)
  assetCount      Int      @default(0)
  materialCount   Int      @default(0)
  modelCost30d    Decimal  @default(0) @db.Decimal(18, 6)
  deviceCount     Int      @default(1)
  linkedUserIds   Json     @default("[]")
  deletedAt       DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([lastActiveAt])
  @@index([authUserId])
  @@index([updatedAt])
  @@index([updatedAt, adminKey])
  @@index([deletedAt, lastActiveAt])
  @@index([storageBytes])
  @@index([last30TaskCount])
}

model AdminWorkFeed {
  generationId Int       @id
  sourceEventId Int      @default(0)
  userId       String
  authUserId   Int?
  type         String
  status       String
  source       String
  provider     String?
  model        String?
  mediaKind    String
  thumbUrl     String?
  previewUrl   String?
  displayUrl   String?
  posterUrl    String?
  sizeBytes    Int?
  sizeBytes64  BigInt?
  errorCode    String?
  errorMsg     String?
  createdAt    DateTime
  finishedAt   DateTime?
  updatedAt    DateTime
  deletedAt    DateTime?

  @@index([authUserId, createdAt, generationId])
  @@index([authUserId, type, createdAt, generationId])
  @@index([authUserId, status, createdAt, generationId])
  @@index([userId, createdAt, generationId])
  @@index([updatedAt, generationId])
  @@index([deletedAt, createdAt])
  @@index([sourceEventId])
}

model CanvasMutation {
  id                 BigInt   @id @default(autoincrement())
  canvasId           Int
  canvas             Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  actorUserId        Int
  actorUser          User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  clientMutationId   String   @db.Uuid
  clientSequence     BigInt
  payloadHash        String   @db.Char(64)
  baseRevision       BigInt
  revision           BigInt
  protocolVersion    Int
  operations         Json
  touchedPaths       Json
  createdAt          DateTime @default(now())

  @@unique([canvasId, revision])
  @@unique([canvasId, clientMutationId])
  @@index([canvasId, revision])
  @@index([actorUserId, createdAt])
}

model CanvasSnapshot {
  id                       BigInt   @id @default(autoincrement())
  canvasId                 Int
  canvas                   Canvas   @relation("CanvasSnapshots", fields: [canvasId], references: [id], onDelete: Cascade)
  currentForCanvas         Canvas?  @relation("CanvasCurrentSnapshot")
  revision                 BigInt
  documentSchemaVersion    Int
  operationProtocolVersion Int
  codec                    String   @default("gzip")
  compressedJson           Bytes
  uncompressedBytes        Int
  checksumSha256           String   @db.Char(64)
  nodeCount                Int
  edgeCount                Int
  createdAt                DateTime @default(now())

  @@unique([canvasId, revision])
  @@index([canvasId, createdAt])
}

model CanvasNodeState {
  canvasId   Int
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  nodeId     String
  nodeVersion BigInt
  kind       String
  positionX  Float
  positionY  Float
  width      Float?
  height     Float?
  parentId   String?
  zIndex     Int      @default(0)
  data       Json
  searchText String   @default("")
  updatedAt  DateTime @updatedAt

  @@id([canvasId, nodeId])
  @@index([canvasId, parentId])
  @@index([canvasId, kind])
  @@index([canvasId, updatedAt])
}

model CanvasEdgeState {
  canvasId   Int
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  edgeId     String
  edgeVersion BigInt
  sourceId   String
  targetId   String
  bboxMinX   Float?
  bboxMinY   Float?
  bboxMaxX   Float?
  bboxMaxY   Float?
  data       Json
  updatedAt  DateTime @updatedAt

  @@id([canvasId, edgeId])
  @@index([canvasId, sourceId])
  @@index([canvasId, targetId])
  @@index([canvasId, updatedAt])
}

model CanvasMember {
  canvasId Int
  canvas   Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

