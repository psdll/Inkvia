  resolvedMediaUrls Json      @default("[]")
  generatedPrompt   String?   @db.Text
  errorMsg          String?   @db.Text
  rawResponse       Json?
  skillSource       String?   @db.VarChar(16)
  skillId           BigInt?
  skillName         String?   @db.VarChar(64)
  skillRevision     Int?
  startedAt         DateTime?
  finishedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([authUserId, createdAt])
  @@index([authUserId, status, createdAt])
  @@index([authUserId, deletedAt, createdAt])
}

model ToolWorkspaceDraft {
  id            String                    @id @default(uuid()) @db.Uuid
  authUserId    Int
  authUser      User                      @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  tool          String                    @db.VarChar(16)
  schemaVersion Int                       @default(1)
  payload       Json                      @default("{}")
  version       Int                       @default(1)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  media         ToolWorkspaceDraftMedia[]

  @@unique([authUserId, tool])
  @@index([authUserId, updatedAt])
}

model ToolWorkspaceDraftMedia {
  id        BigInt             @id @default(autoincrement())
  draftId   String             @db.Uuid
  draft     ToolWorkspaceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mediaId   String             @db.Uuid
  media     MediaAsset         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int
  slot      String?            @db.VarChar(16)
  createdAt DateTime           @default(now())

  @@unique([draftId, position])
  @@index([mediaId])
}

model RolePositioningDraft {
  id                    Int      @id @default(autoincrement())
  authUserId            Int
  authUser              User     @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  surface               String   @db.VarChar(32)
  systemPrompt          String   @default("") @db.Text
  reversePrompt         String   @default("") @db.Text
  reversePromptApplied  Boolean  @default(false)
  activeReverseTaskId   Int?
  continuation          Json?
  selectedSkillSource   String?  @db.VarChar(16)
  selectedSkillId       BigInt?
  resultSkillSource     String?  @db.VarChar(16)
  resultSkillId         BigInt?
  resultSkillName       String?  @db.VarChar(64)
  resultSkillRevision   Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([authUserId, surface])
  @@index([authUserId, updatedAt])
}

model MaterialAsset {
  id               Int      @id @default(autoincrement())
  category         String?
  title            String
  imageUrl         String
  thumbnailUrl     String?
  previewUrl       String?
  mimeType         String?
  sizeBytes        Int?
  media            Json     @default("[]")
  mediaCount       Int      @default(1)
  selectedMediaId  String?
  tags             String   @default("[]")
  creatorName      String?
  modelName        String?
  inspiration      String?
  sortOrder        Int      @default(0)
  createdByUserId  Int?
  selectedByUserId Int?
  selectedAt       DateTime?
  listedAt         DateTime?
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdByUser  User?                   @relation("MaterialAssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  selectedByUser User?                   @relation("MaterialAssetSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  downloads      MaterialAssetDownload[]
  selectionEvents MaterialAssetSelectionEvent[]

  @@index([category, createdAt])
  @@index([isDeleted, category, createdAt])
  @@index([selectedByUserId, selectedAt])
  @@index([isDeleted, selectedByUserId, createdAt])
  @@index([isDeleted, selectedByUserId, listedAt])
  @@index([updatedAt, id])
  @@index([creatorName, isDeleted])
  @@index([createdByUserId, createdAt])
  @@index([modelName])
}

model MaterialAssetOption {
  id        Int      @id @default(autoincrement())
  kind      String
  value     String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, value])
}

model MaterialAssetDownload {
  id           Int      @id @default(autoincrement())
  assetId      Int
  userId       Int
  username     String
  downloadedAt DateTime @default(now())

  asset MaterialAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId, downloadedAt])
  @@index([userId, downloadedAt])
}

model MaterialAssetSelectionEvent {
  id               Int      @id @default(autoincrement())
  assetId          Int
  userId           Int?
  username         String
  action           String
  reason           String?
  operatorUsername String?
  assetTitle       String?
  assetCategory    String?
  assetImageUrl    String?
  assetThumbnailUrl String?
  selectedMediaId  String?
  selectedMediaUrl String?
  occurredAt       DateTime @default(now())

  asset MaterialAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([assetId, occurredAt])
  @@index([userId, occurredAt])
  @@index([action, occurredAt])
}

model AgentConversation {
  id            Int       @id @default(autoincrement())
  userId        Int
  title         String?
  summary       String?
  summaryUntil  Int?
  summaryRevision Int     @default(0)
  summarySource Json?
  messageCount  Int       @default(0)
  status        String    @default("active")
  deletedAt     DateTime?
  purgeAfter    DateTime?
  deletedBy     String?
  lastMessageAt DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AgentMessage[]
  events          AgentEvent[]
  generationLinks AgentGenerationLink[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, deletedAt, lastMessageAt])
  @@index([purgeAfter])
}

model AgentMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String
  kind           String   @default("text")
  runId          Int?
  sequence       Int?
  status         String   @default("completed")
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@unique([conversationId, sequence])
  @@index([runId, createdAt])
  @@index([userId, createdAt])
}

model UserMemory {
  id              Int       @id @default(autoincrement())
  userId          Int
  type            String
  key             String
  value           String
  history         String?
  confidence      Float     @default(0.8)
  version         Int       @default(1)
  usageCount      Int       @default(0)
  lastUsedAt      DateTime?
  sourceMessageId Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, lastUsedAt])
}

model AgentMemoryProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  revision     Int       @default(0)
  deletedAt    DateTime?
  fileSyncedAt DateTime?
  syncError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id             Int       @id @default(autoincrement())
  userId         Int
  conversationId Int?
  model          String
  purpose        String
  status         String
  requestKey     String?    @unique @db.Uuid
  routeSnapshot  Json?
  brief          Json?
  plan           Json?
  generationApproval Json?
  runtimeVersion Int       @default(1)
  planRevision   Int       @default(0)
  deliverySpec   Json?
  validationSummary Json?
  budgetPolicy   Json?
  budgetRevision Int       @default(1)
  skillSnapshot  Json?
  lastProgressAt DateTime?
  activeMs       Int       @default(0)
  repairCount    Int       @default(0)
  currentStage   String?
  waitingReason  String?
  attempt        Int        @default(0)
  availableAt    DateTime?
  leaseOwner     String?
  leaseUntil     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorCode      String?
  cancelRequestedAt DateTime?
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  events          AgentEvent[]
  generationLinks AgentGenerationLink[]
  steps           AgentStepExecution[]
  artifacts       AgentArtifact[]
  calls           AgentCallRecord[]

  @@index([userId, createdAt])
  @@index([purpose, status])
  @@index([status, availableAt, leaseUntil])
  @@index([conversationId, createdAt])
}

model AgentStepExecution {
  id                 String    @id @default(cuid())
  runId              Int
  stepKey            String
  introducedRevision Int
  definitionSnapshot Json
  status             String    @default("pending")
  version            Int       @default(1)
  activeAttemptNo    Int       @default(0)
  result             Json?
  errorCode          String?
  nextEligibleAt     DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  run                AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts           AgentStepAttempt[]
  artifacts          AgentArtifact[]
  @@unique([runId, stepKey])
  @@index([runId, status, nextEligibleAt])
}

model AgentStepAttempt {
  id             String   @id @default(cuid())
  stepId         String
  attemptNo      Int
  requestKey     String   @unique @db.Uuid
  state          String   @default("prepared")
  inputSnapshot  Json
  inputDigest    String
  submissionRefs Json
  reservedUnits  Int      @default(0)
  budgetRevision Int
  errorClass     String?
  retryCount     Int      @default(0)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  step           AgentStepExecution @relation(fields: [stepId], references: [id], onDelete: Cascade)
  artifacts      AgentArtifact[]
  @@unique([stepId, attemptNo])
  @@index([state, startedAt])
}

model AgentArtifact {
  id               String   @id @default(cuid())
  runId            Int
  stepId           String
  attemptId        String
  outputSlot       Int
  kind             String
  generationId     Int?
  source           Json?
  storageRef       String?
  text             String?  @db.Text
  contentVersion   String
  availability     String   @default("unverified")
  facts            Json?
  observation      Json?
  validationReport Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  run              AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step             AgentStepExecution @relation(fields: [stepId], references: [id], onDelete: Cascade)
  attempt          AgentStepAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, outputSlot])
  @@index([runId, stepId, outputSlot])
  @@index([generationId])
}

// Minimal reconciliation identity survives deleting conversation content. No raw requests/keys.
model AgentCallRecord {
  id                  String   @id @default(cuid())
  runId               Int?
  stepId              String?
  attemptId           String?
  logicalOperationKey String
  callAttemptNo       Int
  purpose             String
  state               String
  routeSnapshot       Json?
  inputDigest         String?
  result              Json?
  usage               Json?
  priceSnapshot       Json?
  reservedInputTokens Int
  reservedOutputTokens Int
  inputTokens         Int?
  outputTokens        Int?
  reservedAmount      Decimal? @db.Decimal(20, 8)
  amount              Decimal? @db.Decimal(20, 8)
  currency            String?
  costState           String   @default("unknown")
  budgetRevision      Int
  errorCode           String?
  startedAt           DateTime @default(now())
  finishedAt          DateTime?
  run                 AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@unique([logicalOperationKey, callAttemptNo])
  @@index([runId, startedAt])
  @@index([state, startedAt])
}

model AgentEvent {
  id             BigInt   @id @default(autoincrement())
  runId          Int
  conversationId Int
  sequence       Int
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([conversationId, id])
}

model AgentGenerationLink {
  id             BigInt    @id @default(autoincrement())
  runId          Int
  conversationId Int
  messageId      Int?
  generationId   Int
  taskType       String
  stepKey        String
  requestKey     String    @unique @db.Uuid
  userDeletedAt  DateTime?
  purgeAfter     DateTime?
  createdAt      DateTime  @default(now())

  run          AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey])
  @@index([conversationId, createdAt])
  @@index([generationId])
  @@index([purgeAfter])
}

/// 用户数据导出任务（异步打包）。点击导出后入队，后台 worker 流式打包到磁盘，
/// 前端轮询进度，完成后凭一次性 token 流式下载。
model UserExportJob {
  id         String    @id @default(cuid())
  userId     String
  authUserId Int?
  status     String    @default("pending") // pending|running|done|error|expired
  options    String? // 导出勾选项 JSON
  progress   Int       @default(0) // 0-100
  stage      String? // query|collect|pack|done
  filePath   String? // 生成的 zip 磁盘绝对路径（不在 public 下）
  fileName   String? // 面向用户的下载文件名
  fileSize   BigInt? // 最终文件大小（字节）
  token      String? // 一次性下载凭证
  error      String? // 失败原因
  manifest   String? // 完成后的 stats/missing JSON
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  expiresAt  DateTime? // 过期清理时间

  @@index([status])
  @@index([userId])
  @@index([expiresAt])
}

model UserImportJob {
  id         String    @id @default(cuid())
  status     String    @default("pending") // pending|running|done|error|expired|cancelled
  stage      String? // upload|parse|read|check|db_user|db_gen|db_other|db_agent|db_logs|seq|presets|files|done
  progress   Int       @default(0) // 0-100
  filePath   String?
  fileName   String?
  fileSize   BigInt?
  error      String?
  manifest   String?
  stats      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  expiresAt  DateTime?

  @@index([status])
  @@index([expiresAt])
}
