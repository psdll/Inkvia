# PostgreSQL 连接地址。请填入实际数据库密码，特殊字符需要进行 URL 编码。
DATABASE_URL="postgresql://inkvia:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/inkvia?schema=public"
# PostgreSQL 数据库身份标识，须与 ALTER DATABASE 设置的 inkvia.instance_id 完全一致。
INKVIA_DB_INSTANCE_ID="REPLACE_WITH_DATABASE_UUID"
# 项目安装目录的真实绝对路径，可在项目目录运行 pwd -P 查看。
APP_ROOT_DIR="/path/to/Inkvia"
# 与源码分开的数据根目录。升级时保留整个目录。
INKVIA_DATA_DIR="/path/to/Inkvia-data"
# 图片、视频及用户上传的文件存放目录。
UPLOADS_DIR="${INKVIA_DATA_DIR}/uploads"
# 用户数据导入包目录。
IMPORTS_DIR="${INKVIA_DATA_DIR}/imports"
# 用户数据导出包目录。
EXPORTS_DIR="${INKVIA_DATA_DIR}/exports"
# 运行隔离策略文件，由 README 的首次配置命令生成。
INKVIA_RUNTIME_POLICY="${INKVIA_DATA_DIR}/runtime-policy.json"
# 管理后台登录用户名。
ADMIN_USERNAME="admin"
# 管理后台登录密码，请更换成独立的强随机密码。
ADMIN_PASSWORD="REPLACE_ADMIN_PASSWORD"
# 管理员会话签名密钥，请使用 openssl rand -hex 32 单独生成。
ADMIN_SECRET="REPLACE_ADMIN_SECRET"
# 用户密码加密密钥环文件，由 README 的首次配置命令生成。
PASSWORD_CIPHER_KEYRING_FILE="${INKVIA_DATA_DIR}/password-keys.json"
# 密钥环中当前使用的密钥名称，升级时保留原值和原密钥。
PASSWORD_CIPHER_ACTIVE_KEY_ID="web-v1"
# 服务对自身发请求时使用的访问地址，端口请与网页服务一致。
APP_ORIGIN="http://127.0.0.1:3000"
