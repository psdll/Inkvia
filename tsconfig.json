{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noErrorTruncation": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev-codex/types/**/*.ts",
    ".next-sim/types/**/*.ts",
    ".next-dev-web/types/**/*.ts",
    ".next-dev-webpack/types/**/*.ts",
    ".next-p0/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp",
    "output",
    ".codex-artifacts",
    ".codex_tmp",
    ".runtime-local"
  ]
}
